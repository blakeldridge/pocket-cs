---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="navbar">
    <a href="/" class="logo">⚡ Pocket CS</a>
    
    <nav class="nav-links">
<HeaderLink href="/" class="nav-btn">Home</HeaderLink>
        <HeaderLink href="/blog" class="nav-btn">Blog</HeaderLink>
        <HeaderLink href="/about" class="nav-btn">About</HeaderLink>
    </nav>

    <div class="actions">
        <ThemeToggle />
    </div>
</header>

<style>
    .navbar {
        background: var(--bg-card);
        border: var(--border-mega);
        box-shadow: var(--shadow-hard);
        border-radius: var(--radius-cartoon);
        padding: 0.75rem 1.25rem;
        
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        
        margin-bottom: 2rem;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .logo {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--text-primary);
        letter-spacing: -0.02em;
        justify-self: start;
    }

    .nav-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-self: center;
    }

    .actions {
        justify-self: end;
        display: flex;
        align-items: center;
    }

    .nav-btn {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        text-decoration: none;
        color: var(--text-secondary);
        border-radius: 8px;
        transition: all 0.15s ease;
        border: 2px solid transparent;
    }

    .nav-btn:hover {
        color: var(--text-primary);
        background: var(--bg-main);
    }

    .nav-btn.active {
        color: var(--text-primary);
        background: var(--bg-card);
        border: var(--border-thick);
        box-shadow: 2px 2px 0px var(--color-black);
    }

    @media (max-width: 768px) {
        .navbar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            justify-content: space-between;
        }

        .nav-links {
            order: 3;
            width: 100%;
            justify-content: center;
        }
    }
</style>