---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo-group">
          <span class="logo-icon">⚡</span>
          <span class="logo-text">Pocket CS</span>
        </div>
        <p class="brand-subtext">
          Mark scheme-focused Computer Science revision, model answers, and zero-fluff exam breakdowns.
        </p>
      </div>

      <div class="footer-links-group">
        <span class="links-title">Quick Links</span>
        <ul class="footer-links">
          <li><a href="/notes">All Notes</a></li>
          <li><a href="/notes?board=aqa">AQA Notes</a></li>
          <li><a href="/notes?board=ocr-a">OCR Notes</a></li>
          <li><a href="/about">About Me</a></li>
        </ul>
      </div>

      <div class="footer-social-group">
        <span class="links-title">Connect</span>
        <div class="social-links">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>

          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>

          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {today.getFullYear()} CS Prep Hub. All rights reserved.</p>
      <span class="badge-mini">Built for A-Level & GCSE success</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3rem 1.5rem 2rem 1.5rem;
    background: var(--bg-card);
    border-top: var(--border-mega);
    position: relative;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-icon {
    font-size: 1.2rem;
    background: var(--accent-lime);
    padding: 0.2rem 0.4rem;
    border: var(--border-thick);
    border-radius: 8px;
    box-shadow: 2px 2px 0px var(--color-black);
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .brand-subtext {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .links-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.75rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-family: var(--font-code);
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--text-primary);
    transform: translateX(3px);
  }

  .social-links {
    display: flex;
    gap: 0.65rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--bg-body);
    color: var(--text-primary);
    border: var(--border-thick);
    border-radius: 10px;
    box-shadow: var(--shadow-hard-sm);
    text-decoration: none;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
  }

  .social-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--color-black);
    background: var(--accent-pink);
    color: var(--color-black);
  }

  .social-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--color-black);
  }

  .footer-bottom {
    border-top: 2px dashed var(--dot-color);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .badge-mini {
    background: var(--accent-yellow, #facc15);
    color: var(--color-black);
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border: var(--border-thick);
    border-radius: 6px;
    box-shadow: 2px 2px 0px var(--color-black);
  }
</style>