    <div class="footer-bottom">
      <p>&copy; {today.getFullYear()} Pocket CS. All rights reserved.</p>
      <span class="badge-mini">Built for A-Level & GCSE students</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3rem 1.5rem 2rem 1.5rem;
    background: var(--bg-card);
    border-top: var(--border-mega);
    position: relative;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-icon {
    font-size: 1.2rem;
    background: var(--accent-lime);
    padding: 0.2rem 0.4rem;
    border: var(--border-thick);
    border-radius: 8px;
    box-shadow: 2px 2px 0px var(--color-black);
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .brand-subtext {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .links-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.75rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-family: var(--font-code);
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--text-primary);
    transform: translateX(3px);
  }

  .social-links {
    display: flex;
    gap: 0.65rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--bg-body);
    color: var(--text-primary);
    border: var(--border-thick);
    border-radius: 10px;
    box-shadow: var(--shadow-hard-sm);
    text-decoration: none;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
  }

  .social-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--color-black);
    background: var(--accent-pink);
    color: var(--color-black);
  }

  .social-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--color-black);
  }

  .footer-bottom {
    border-top: 2px dashed var(--dot-color);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .badge-mini {
    background: var(--accent-yellow, #facc15);
    color: var(--color-black);
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border: var(--border-thick);
    border-radius: 6px;
    box-shadow: 2px 2px 0px var(--color-black);
  }
</style>