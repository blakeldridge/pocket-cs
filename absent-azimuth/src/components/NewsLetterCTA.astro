---
---

<section class="newsletter-section">
  <div class="newsletter-card">
    <div class="badge-row">
      <span class="badge">📩 Free Weekly Prep</span>
    </div>

    <h2>Get Weekly Exam Questions</h2>
    <p class="description">
      Start receiving a set of exam questions, model mark schemes, and common pitfall breakdowns every Sunday evening.
    </p>

    <form class="newsletter-form" action="https://buttondown.com/api/emails/embed-subscribe/blakeldridge" method="POST">
      <div class="input-wrapper">
        <input 
          type="email" 
          name="email" 
          placeholder="student@school.co.uk" 
          required 
          class="email-input"
          aria-label="Your email address"
        />
        <button type="submit" class="submit-btn">
          <span>Subscribe</span>
          <span class="icon" aria-hidden="true">⚡</span>
        </button>
      </div>
      <p class="form-subtext">🔒 No spam ever. Unsubscribe in 1-click anytime.</p>
    </form>
  </div>
</section>

<style>
    .newsletter-section {
        margin-bottom: 3.5rem;
    }

    .newsletter-card {
        background: var(--bg-card);
        border: var(--border-mega);
        box-shadow: var(--shadow-hard);
        border-radius: var(--radius-cartoon);
        padding: 1rem 1.5rem;
        text-align: center;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

    .badge {
        display: inline-block;
        font-family: var(--font-code);
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.65rem;
        border: var(--border-thick);
        border-radius: var(--radius-pill);
        background: var(--accent-lime);
        color: var(--color-black);
        box-shadow: 2px 2px 0px var(--color-black);
        margin-bottom: 1rem;
    }

    h2 {
        font-family: var(--font-heading);
        font-size: 2.2rem;
        color: var(--text-primary);
        line-height: 1.1;
        margin-bottom: 0.75rem;
    }

    .description {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.5;
        max-width: 520px;
        margin: 0 auto 1.75rem auto;
    }

    .newsletter-form {
        max-width: 480px;
        margin: 0 auto;
    }

    .input-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    @media (min-width: 520px) {
        .input-wrapper {
        flex-direction: row;
        gap: 0.5rem;
        }
    }

    .email-input {
        flex-grow: 1;
        font-family: var(--font-code);
        font-size: 0.95rem;
        padding: 0.85rem 1rem;
        border: var(--border-thick);
        border-radius: 12px;
        background: var(--bg-body, #fff);
        color: var(--text-primary);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .email-input:focus {
        box-shadow: 3px 3px 0px var(--color-black);
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.85rem 1.4rem;
        background: var(--accent-pink);
        color: var(--color-black);
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1rem;
        border: var(--border-thick);
        border-radius: 12px;
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
        white-space: nowrap;
    }

    .submit-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0px var(--color-black);
    }

    .submit-btn:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px var(--color-black);
    }

    .form-subtext {
        font-family: var(--font-code);
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-top: 0.75rem;
        opacity: 0.85;
    }
</style>