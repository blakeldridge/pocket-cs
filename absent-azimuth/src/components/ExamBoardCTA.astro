---
import { EXAM_BOARDS } from '../consts.ts';
---

<section class="board-jump-section">
  <div class="card-container">
    <div class="content-left">
      <span class="badge">🚀 Fast-Track Revision</span>
      <h2>Find Your Notes Now</h2>
      <p class="subtitle">Select your exam board to jump straight to blogs, notes and content specific to you.</p>
    </div>

    <div class="boards-grid">
      {EXAM_BOARDS.map((board) => (
        <a 
          href={`/blog?board=${board.query}`} 
          class="board-btn" 
          style={`--btn-accent: ${board.color};`}
        >
          <span class="board-name">{board.name}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
    .board-jump-section {
        margin-bottom: 3.5rem;
    }

    .card-container {
        background: var(--bg-card);
        border: var(--border-mega);
        box-shadow: var(--shadow-hard);
        border-radius: var(--radius-cartoon);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .card-container {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        }
        .content-left {
        max-width: 45%;
        }
    }

    .badge {
        display: inline-block;
        font-family: var(--font-code);
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.65rem;
        border: var(--border-thick);
        border-radius: var(--radius-pill);
        background: var(--accent-pink);
        color: var(--color-black);
        box-shadow: 2px 2px 0px var(--color-black);
        margin-bottom: 0.75rem;
    }

    h2 {
        font-family: var(--font-heading);
        font-size: 2rem;
        color: var(--text-primary);
        line-height: 1.1;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.4;
    }

    .boards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.85rem;
        flex-grow: 1;
    }

    @media (max-width: 400px) {
        .boards-grid {
            grid-template-columns: 1fr;
        }
    }

    .board-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1rem;
        background: var(--btn-accent);
        color: var(--color-black);
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1rem;
        text-decoration: none;
        border: var(--border-thick);
        border-radius: 12px;
        box-shadow: var(--shadow-hard-sm);
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .board-btn:hover {
        transform: translate(-3px, -3px);
        box-shadow: 4px 4px 0px var(--color-black);
    }

    .board-btn:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px var(--color-black);
    }

    .arrow {
        font-family: var(--font-code);
        font-size: 1.2rem;
        transition: transform 0.15s ease;
    }

    .board-btn:hover .arrow {
        transform: translateX(4px);
    }
</style>