---
import { REVIEWS } from '../consts.ts';
const getStars = (count: number) => "⭐".repeat(count);
---

<section class="testimonials-section">
  <div class="section-header">
    <div class="title-group">
      <span class="badge">⭐ PMT Education Tutor</span>
      <h2>Student Reviews</h2>
    </div>
    
    <div class="hours-card">
      <span class="hours-num">500+</span>
      <span class="hours-label">Hours Taught Online</span>
    </div>
  </div>

  <div class="grid">
    {REVIEWS.map((review) => (
      <div class="review-card">
        <div class="card-top">
          <span class="stars" aria-label={`${review.rating} out of 5 stars`}>
            {getStars(review.rating)}
          </span>
        </div>
        
        <p class="comment">"{review.comment}"</p>
        
        <div class="card-footer">
          <span class="author">{review.name}</span>
          <span class="date">{review.date}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .testimonials-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border: var(--border-thick);
    border-radius: var(--radius-pill);
    background: var(--accent-pink);
    color: var(--color-black);
    box-shadow: 2px 2px 0px var(--color-black);
    margin-bottom: 0.5rem;
  }

  h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .hours-card {
    background: var(--bg-card);
    border: var(--border-thick);
    box-shadow: var(--shadow-hard-sm);
    border-radius: 12px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hours-num {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    background: var(--accent-lime);
    padding: 0.1rem 0.5rem;
    border: var(--border-thick);
    border-radius: 6px;
  }

  .hours-label {
    font-family: var(--font-code);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .review-card {
    background: var(--bg-card);
    border: var(--border-mega);
    box-shadow: var(--shadow-hard);
    border-radius: var(--radius-cartoon);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .review-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard-lg);
  }

  .card-top {
    margin-bottom: 0.8rem;
  }

  .stars {
    font-size: 0.95rem;
    letter-spacing: 2px;
  }

  .comment {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-primary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed var(--dot-color);
    padding-top: 0.75rem;
  }

  .author {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .date {
    font-family: var(--font-code);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    opacity: 0.85;
  }
</style>