---
import { REVIEWS } from '../consts.ts';
const getStars = (count: number) => "⭐".repeat(count);
---

<section class="testimonials-section">
  <div class="section-header">
    <div class="title-group">
      <span class="badge">⭐ PMT Education Tutor</span>
      <h2>Student Reviews</h2>
    </div>
    
    <div class="hours-card">
      <span class="hours-num">500+</span>
      <span class="hours-label">Hours Taught Online</span>
    </div>
  </div>

  <div class="carousel-wrapper">
    <button id="prev-btn" aria-label="Previous Reviews" class="nav-btn prev-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <div class="carousel-container" id="carousel-container">
      <div class="grid" id="reviews-track">
        {REVIEWS.map((review) => {
          const isLong = review.comment.length > 140;
          const shortComment = isLong ? review.comment.slice(0, 140).trim() + "..." : review.comment;

          return (
            <div class="review-card">
              <div class="card-content">
                <div class="card-top">
                  <span class="stars" aria-label={`${review.rating} out of 5 stars`}>
                    {getStars(review.rating)}
                  </span>
                </div>
                
                <p class="comment" data-full={review.comment} data-short={shortComment}>
                  "{isLong ? shortComment : review.comment}"
                </p>

                {isLong && (
                  <button class="toggle-btn" aria-expanded="false">Read More</button>
                )}
              </div>
              
              <div class="card-footer">
                <span class="author">{review.name}</span>
                <span class="date">{review.date}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <button id="next-btn" aria-label="Next Reviews" class="nav-btn next-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <!-- Bottom CTA Box -->
  <div class="cta-box">
    <div class="cta-text">
      <h3>Want 1-on-1 Tutoring?</h3>
    </div>
    <a href="https://www.pmt.education/tutor/tutor-profile/blake-e" class="cta-btn">Book Now! ➔</a>
  </div>
</section>

<script>
  function setupCarousel() {
    const container = document.getElementById('carousel-container');
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement | null;

    if (!container || !track || !prevBtn || !nextBtn) return;

    let currentIndex = 0;
    const cards = track.children;

    const updateCarousel = () => {
      const totalCards = cards.length;
      const visibleCards = window.innerWidth <= 768 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
      const maxIndex = Math.max(0, totalCards - visibleCards);

      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      const gap = 24;
      const cardWidth = cards[0]?.clientWidth || 0;
      const offset = currentIndex * (cardWidth + gap);

      track.style.transform = `translateX(-${offset}px)`;

      if (currentIndex === 0 && maxIndex > 0) {
        const maskStyle = 'linear-gradient(to right, black 0%, black 85%, transparent 100%)';
        container.style.maskImage = maskStyle;
        container.style.webkitMaskImage = maskStyle;
      } else if (currentIndex >= maxIndex) {
        const maskStyle = 'linear-gradient(to right, transparent 0%, black 15%, black 100%)';
        container.style.maskImage = maskStyle;
        container.style.webkitMaskImage = maskStyle;
      } else {
        const maskStyle = 'linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%)';
        container.style.maskImage = maskStyle;
        container.style.webkitMaskImage = maskStyle;
      }

      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex >= maxIndex;
    };

    track.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('toggle-btn')) return;

      const card = target.closest('.review-card');
      const commentEl = card?.querySelector('.comment') as HTMLElement;

      if (!commentEl) return;

      const isExpanded = target.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        commentEl.textContent = `"${commentEl.dataset.short}"`;
        target.textContent = 'Read More';
        target.setAttribute('aria-expanded', 'false');
      } else {
        commentEl.textContent = `"${commentEl.dataset.full}"`;
        target.textContent = 'Read Less';
        target.setAttribute('aria-expanded', 'true');
      }

      updateCarousel();
    });

    nextBtn.addEventListener('click', () => {
      const visibleCards = window.innerWidth <= 768 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
      const maxIndex = Math.max(0, cards.length - visibleCards);

      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    });

    window.addEventListener('resize', updateCarousel);
    updateCarousel();
  }

  setupCarousel();
  document.addEventListener('astro:page-load', setupCarousel);
</script>

<style>
  .testimonials-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border: var(--border-thick);
    border-radius: var(--radius-pill);
    background: var(--accent-pink);
    color: var(--color-black);
    box-shadow: 2px 2px 0px var(--color-black);
    margin-bottom: 0.5rem;
  }

  h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .hours-card {
    background: var(--bg-card);
    border: var(--border-thick);
    box-shadow: var(--shadow-hard-sm);
    border-radius: 12px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hours-num {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    background: var(--accent-lime);
    padding: 0.1rem 0.5rem;
    border: var(--border-thick);
    border-radius: 6px;
  }

  .hours-label {
    font-family: var(--font-code);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .carousel-container {
    overflow: hidden;
    width: 100%;
    padding: 0.5rem;
    margin: -0.5rem;
    transition: mask-image 0.3s ease, -webkit-mask-image 0.3s ease;
  }

  .nav-btn {
    background: var(--bg-card);
    border: 2px solid var(--dot-color);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    opacity: 0.45;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .nav-btn:hover:not(:disabled) {
    opacity: 1;
    color: var(--text-primary);
    border-color: var(--color-black);
    transform: scale(1.08);
  }

  .nav-btn:disabled {
    opacity: 0.15;
    cursor: not-allowed;
    border-color: var(--dot-color);
  }

  .grid {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .review-card {
    flex: 0 0 calc((100% - 3rem) / 3);
    box-sizing: border-box;
    background: var(--bg-card);
    border: var(--border-mega);
    box-shadow: var(--shadow-hard);
    border-radius: var(--radius-cartoon);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .review-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard-lg);
  }

  .card-top {
    margin-bottom: 0.8rem;
  }

  .stars {
    font-size: 0.95rem;
    letter-spacing: 2px;
  }

  .comment {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-primary);
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .toggle-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed var(--dot-color);
    padding-top: 0.75rem;
    margin-top: 1rem;
  }

  .author {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .date {
    font-family: var(--font-code);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    opacity: 0.85;
  }

  /* Bottom CTA Box Styling */
  .cta-box {
    background: var(--bg-card);
    border: var(--border-mega);
    box-shadow: var(--shadow-hard);
    border-radius: var(--radius-cartoon);
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin: 1rem 3rem 0;
    background: var(--accent-purple, #a855f7);
  }

  .cta-text h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .cta-text p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .cta-btn {
    background: var(--accent-lime, #b1f100);
    color: var(--color-black);
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 1.25rem;
    border: var(--border-thick);
    border-radius: 12px;
    box-shadow: var(--shadow-hard-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cta-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard);
    color: var(--color-black);
  }

  @media (max-width: 1024px) {
    .review-card {
      flex: 0 0 calc((100% - 1.5rem) / 2);
    }
  }

  @media (max-width: 768px) {
    .review-card {
      flex: 0 0 100%;
    }
    .carousel-wrapper {
      gap: 0.35rem;
    }
    .cta-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
    .cta-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>