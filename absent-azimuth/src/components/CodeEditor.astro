<h2 class="section-title">💻 Code Block Aesthetic (Shiki Wrapper)</h2>
<div class="editor-wrapper">
    <div class="editor-topbar">
    <div class="editor-dots">
        <div class="dot dot-red"></div>
        <div class="dot dot-yellow"></div>
        <div class="dot dot-green"></div>
    </div>
    <span class="editor-title">dijkstra_search.py</span>
    <span style="color:#6c7086; font-size:0.8rem; font-family:var(--font-code);">Python 3.12</span>
    </div>
    <div class="editor-code">
        <p>"Hello World!"</p>
    </div>
</div>

<style>
 .editor-wrapper {
      background: #1e1e2e;
      borden to sharp or: var(--border-mega);
      box-shadow: var(--shadow-hard-lg);
      border-radius: var(--radius-cartoon);
      overflow: hidden;
      margin: 2rem 0;
    }

    .editor-topbar {
      background: #11111b;
      border-bottom: 3px solid #000;
      padding: 0.6rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .editor-dots {
      display: flex;
      gap: 8px;
    }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid #000;
    }
    .dot-red { background: #f38ba8; }
    .dot-yellow { background: #f9e2af; }
    .dot-green { background: #a6e3a1; }

    .editor-title {
      color: #cdd6f4;
      font-family: var(--font-code);
      font-size: 0.85rem;
      font-weight: 700;
    }

    .editor-code {
      padding: 1.2rem;
      color: #cdd6f4;
      font-family: var(--font-code);
      font-size: 0.95rem;
      line-height: 1.6;
      overflow-x: auto;
    }

    .keyword { color: #cba6f7; font-weight: bold; }
    .function { color: #89b4fa; }
    .string { color: #a6e3a1; }
    .comment { color: #6c7086; font-style: italic; }

</style>