    }

    .card-tag {
      align-self: flex-start;
      font-family: var(--font-heading);
      font-size: 0.8rem;
      padding: 0.2rem 0.6rem;
      border: var(--border-thick);
      border-radius: var(--radius-pill);
      margin-bottom: 0.8rem;
    }

    .tag-gcse { background: var(--accent-lime); }
    .tag-alevel { background: var(--accent-purple); color: #fff; }
    .tag-cheatsheet { background: var(--accent-pink); }

    .card h3 {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      line-height: 1.25;
    }

    .card p {
      font-size: 0.95rem;
      color: #475569;
      margin-bottom: 1.2rem;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-code);
      font-size: 0.8rem;
