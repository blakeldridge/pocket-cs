---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import ProfileImg from '../assets/profile.jpeg';

const STATS = [
  { label: 'Degree', value: 'BSc Computer Science', sub: 'First Class Honours' },
  { label: 'A-Level Results', value: 'A*A*A', sub: 'Maths, CS, Physics' },
  { label: 'Tutoring Experience', value: '3+ Years', sub: '500+ Hours Delivered' },
  { label: 'GCSE Results', value: 'Grade 8 CS', sub: '9 Subjects Grade 8+' },
];

const QUALIFICATIONS = [
  { title: 'BSc Computer Science', institution: 'University of Manchester', result: 'First Class', year: '2023 - 2026' },
  { title: 'A-Level Mathematics', institution: 'Sixth Form', result: 'Grade A*', year: '2023' },
  { title: 'A-Level Computer Science', institution: 'Sixth Form', result: 'Grade A*', year: '2023' },
  { title: 'A-Level Physics', institution: 'Sixth Form', result: 'Grade A', year: '2023' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    
    <BaseHead title={`About Me | ${SITE_TITLE}`} description="Learn more about my tutoring background, qualifications, and teaching philosophy." />
    
    <style>
      main {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem 5rem 1rem;
      }

      /* Neo-brutalist shared utility styles */
      .card {
        background: var(--bg-card, #fff);
        border: var(--border-mega, 3px solid #000);
        box-shadow: var(--shadow-hard, 5px 5px 0px #000);
        border-radius: var(--radius-cartoon, 16px);
      }

      .badge {
        display: inline-block;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.65rem;
        border: var(--border-thick, 2px solid #000);
        border-radius: 999px;
        background: var(--accent-pink, #ff71ce);
        color: var(--color-black, #000);
        box-shadow: 2px 2px 0px var(--color-black, #000);
        margin-bottom: 0.75rem;
      }

      /* Hero Section */
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
        margin-bottom: 2.5rem;
      }

      @media (min-width: 768px) {
        .hero-grid {
          grid-template-columns: 1.2fr 0.8fr;
        }
      }

      .hero-text h1 {
        font-size: 2.8rem;
        color: var(--text-primary, #000);
        line-height: 1.1;
        margin-bottom: 1rem;
      }

      .hero-text p {
        font-size: 1.1rem;
        color: var(--text-secondary, #444);
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .image-container {
        position: relative;
      }

      .profile-image-card {
        padding: 0.75rem;
        background: var(--accent-yellow, #facc15);
        transform: rotate(-2deg);
        transition: transform 0.2s ease;
      }

      .profile-image-card:hover {
        transform: rotate(0deg) scale(1.02);
      }

      .profile-image-card img {
        width: 100%;
        height: auto;
        aspect-ratio: 4/5;
        object-fit: cover;
        border-radius: 10px;
        border: var(--border-thick, 2px solid #000);
        display: block;
      }

      /* Stats Grid */
      .stats-section {
        margin-bottom: 3rem;
      }

      .section-title {
        font-family: var(--font-heading, system-ui);
        font-size: 1.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.25rem;
      }

      .stat-card {
        padding: 1.25rem;
        background: var(--bg-card, #fff);
        transition: transform 0.15s ease;
      }

      .stat-card:nth-child(1) { border-top: 6px solid var(--accent-lime, #b1f100); }
      .stat-card:nth-child(2) { border-top: 6px solid var(--accent-pink, #ff71ce); }
      .stat-card:nth-child(3) { border-top: 6px solid var(--accent-purple, #a855f7); }
      .stat-card:nth-child(4) { border-top: 6px solid var(--accent-blue, #60a5fa); }

      .stat-card:hover {
        transform: translate(-3px, -3px);
      }

      .stat-label {
        font-family: var(--font-code, monospace);
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--text-secondary, #555);
        margin-bottom: 0.25rem;
      }

      .stat-value {
        font-family: var(--font-heading, system-ui);
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.2;
        color: var(--text-primary, #000);
        margin-bottom: 0.25rem;
      }

      .stat-sub {
        font-size: 0.85rem;
        color: var(--text-secondary, #666);
      }

      /* Content Layout */
      .about-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      @media (min-width: 850px) {
        .about-layout {
          grid-template-columns: 2fr 1fr;
        }
      }

      .content-card {
        padding: 2rem;
      }

      .bio-content p {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--text-primary, #222);
        margin-bottom: 1.25rem;
      }

      .bio-content p:last-child {
        margin-bottom: 0;
      }

      /* Qualifications List */
      .qualifications-card {
        padding: 1.5rem;
        background: var(--bg-card, #fff);
        height: fit-content;
      }

      .qual-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .qual-item {
        padding-bottom: 1rem;
        border-bottom: 2px dashed var(--dot-color, #ccc);
      }

      .qual-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .qual-title {
        font-weight: 800;
        font-size: 1rem;
        margin-bottom: 0.2rem;
      }

      .qual-meta {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-code, monospace);
        font-size: 0.8rem;
        color: var(--text-secondary, #555);
      }

      .badge-tag {
        font-family: var(--font-heading, system-ui);
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.15rem 0.5rem;
        border: 2px solid #000;
        border-radius: 999px;
        background: var(--accent-lime, #b1f100);
        display: inline-block;
        margin-top: 0.4rem;
      }

      /* Action CTA */
      .cta-box {
        margin-top: 2.5rem;
        background: var(--accent-purple, #a855f7);
        color: #fff;
        padding: 2rem;
        text-align: center;
      }

      .cta-box h2 {
        font-size: 1.8rem;
        color: #fff;
        margin-bottom: 0.5rem;
      }

      .cta-box p {
        color: #f3e8ff;
        margin-bottom: 1.25rem;
      }

      .cta-btn {
        display: inline-block;
        font-family: var(--font-heading, system-ui);
        font-weight: 800;
        font-size: 1rem;
        padding: 0.75rem 1.5rem;
        background: var(--accent-lime, #b1f100);
        color: #000;
        border: var(--border-thick, 2px solid #000);
        border-radius: 12px;
        box-shadow: 4px 4px 0px #000;
        text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .cta-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0px #000;
      }

	  .profile-cta {
      display : flex;
      flex-direction : row;
      gap: 1rem;
      }
    </style>
  </head>
  <body>
    <Header />
    
    <main>
      <!-- Hero Section -->
      <section class="hero-grid">
        <div class="hero-text">
          <span class="badge">👋 Hello World!</span>
          <h1>Hi, I'm Blake Eldridge</h1>
          <p class="subtitle">
            Dedicated to helping students improve at Computer Science, learn to enjoy programming, and conquer their A-levels and GCSEs.
          </p>
		  <div class="profile-cta">
			<a href="https://www.linkedin.com/in/blake-eldridge/" class="cta-btn" style="background-color:#60a5fa;">LinkedIn ➔</a>
			<a href="https://www.pmt.education/tutor/tutor-profile/blake-e" class="cta-btn">1-on-1 Tutoring ➔</a>
		  </div>
        </div>

        <div class="image-container">
          <div class="card profile-image-card">
            <Image src={ProfileImg} alt="Photo of tutor" width={500} height={625} />
          </div>
        </div>
      </section>

      <!-- Key Stats Section -->
      <section class="stats-section">
        <h2 class="section-title">📊 Key Highlights</h2>
        <div class="stats-grid">
          {STATS.map((stat) => (
            <div class="card stat-card">
              <div class="stat-label">{stat.label}</div>
              <div class="stat-value">{stat.value}</div>
              <div class="stat-sub">{stat.sub}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Bio & Details Section -->
      <section class="about-layout">
        <!-- Written Introduction -->
        <div class="card content-card bio-content">
			<h2 class="section-title">📖 About Me</h2>
			<p>
			Hi, my name is Blake! I'm a Computer Science graduate heading into a career in Data Science. As I shift focus away from full-time tutoring, I want to keep helping students by sharing topic breakdowns, algorithm guides, and revision tips right here on my blog!
			</p>
			<p>
			Over the last 3+ years, I’ve clocked in almost 500 hours online on PMT Education, pushing students to top marks across all GCSE and A-Level exam boards. My philosophy is all about teaching you the way you should have been taught in class: no dry textbooks, just practical, hands-on learning with dead-simple explanations.
			</p>
			<p>
			Outside of CS, I’m also an elite gymnast! I’ve been competing since I was 10 and picked up a few university titles along the way. I’ve also dabbled in volleyball, playing for my uni team for 2 years.
			</p>
        </div>

        <!-- Qualifications Sidebar -->
        <aside class="card qualifications-card">
          <h2 class="section-title" style="font-size: 1.35rem;">🎓 Qualifications</h2>
          <ul class="qual-list">
            {QUALIFICATIONS.map((qual) => (
              <li class="qual-item">
                <div class="qual-title">{qual.title}</div>
                <div class="qual-meta">
                  <span>{qual.institution}</span>
                  <span>{qual.year}</span>
                </div>
                <span class="badge-tag">{qual.result}</span>
              </li>
            ))}
          </ul>
        </aside>
      </section>

      <!-- CTA Box -->
      <section class="card cta-box">
        <h2>Ready to Boost Your Grades?</h2>
        <p>Explore my library of free notes and discussions of all things computer science.</p>
        <a href="/blog" class="cta-btn">Browse Revision Notes ➔</a>
      </section>
    </main>

    <Footer />
  </body>
</html>