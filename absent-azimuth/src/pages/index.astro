---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CodeEditor from '../components/CodeEditor.astro';
import PostGrid from '../components/PostGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import ExamBoard from '../components/ExamBoardCTA.astro';
import NewsLetter from '../components/NewsLetterCTA.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com">
  		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  		<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.section-title {
				font-family: var(--font-heading);
				font-size: 2rem;
				margin-bottom: 1.2rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.divider-dashed {
				width: 100%;
				height: 0;
				border-bottom: 3px dashed var(--dot-color);
				margin: 4rem 0;
				opacity: 0.8;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<HeroBanner />
			<h2 class="section-title">🔥 Latest Notes & Guides</h2>
			<PostGrid />
			<div class="divider-dashed"></div>
			<ExamBoard />
			<div class="divider-dashed"></div>
			<Testimonials />
			<div class="divider-dashed"></div>
			<!-- <NewsLetter /> -->
		</main>
		<Footer />
	</body>
</html>
