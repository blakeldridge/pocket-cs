---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const BOARDS = [
  { id: 'all', label: 'All Boards' },
  { id: 'aqa', label: 'AQA' },
  { id: 'ocr-a', label: 'OCR A' },
  { id: 'edexcel', label: 'Edexcel' },
  { id: 'cie', label: 'CIE' },
];

const LEVELS = [
  { id: 'all', label: 'All Levels' },
  { id: 'a-level', label: 'A-Level' },
  { id: 'gcse', label: 'GCSE' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem 5rem 1rem;
      }

      /* Header Section */
      .page-header {
        margin-bottom: 2.5rem;
      }

      .badge {
        display: inline-block;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.65rem;
        border: var(--border-thick, 2px solid #000);
        border-radius: 999px;
        background: var(--accent-pink, #ff71ce);
        color: var(--color-black, #000);
        box-shadow: 2px 2px 0px var(--color-black, #000);
        margin-bottom: 0.75rem;
      }

      h1 {
        font-size: 2.5rem;
        color: var(--text-primary, #000);
        line-height: 1.1;
        margin-bottom: 0.75rem;
      }

      .subtitle {
        font-size: 1.05rem;
        color: var(--text-secondary, #444);
        max-width: 650px;
        line-height: 1.5;
      }

      /* Filter Card */
      .filter-section {
        background: var(--bg-card, #fff);
        border: var(--border-mega, 3px solid #000);
        box-shadow: var(--shadow-hard, 5px 5px 0px #000);
        border-radius: var(--radius-cartoon, 16px);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      @media (min-width: 640px) {
        .filter-group {
          flex-direction: row;
          align-items: center;
        }
      }

      .filter-label {
        font-weight: 800;
        font-size: 0.95rem;
        min-width: 110px;
        color: var(--text-primary, #000);
      }

      .filter-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .filter-btn {
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.4rem 0.85rem;
        background: var(--bg-body, #fff);
        color: var(--text-primary, #000);
        border: var(--border-thick, 2px solid #000);
        border-radius: 10px;
        box-shadow: var(--shadow-hard-sm, 3px 3px 0px #000);
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease;
      }

      .filter-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0px var(--color-black, #000);
      }

      .filter-btn.active {
        background: var(--accent-lime, #b1f100);
        color: var(--color-black, #000);
        box-shadow: 2px 2px 0px var(--color-black, #000);
      }

      /* Results Bar */
      .results-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
        font-family: var(--font-code, monospace);
        font-size: 0.85rem;
        color: var(--text-secondary, #444);
      }

      .reset-btn {
        background: transparent;
        border: none;
        color: var(--text-primary, #000);
        font-family: var(--font-code, monospace);
        font-weight: 700;
        text-decoration: underline;
        cursor: pointer;
      }

      /* Posts Grid */
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .post-card {
        background: var(--bg-card, #fff);
        border: var(--border-mega, 3px solid #000);
        box-shadow: var(--shadow-hard, 5px 5px 0px #000);
        border-radius: var(--radius-cartoon, 16px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        position:relative;
      }

      .post-card:hover {
        transform: translate(-3px, -3px);
        box-shadow: var(--shadow-hard-lg, 8px 8px 0px #000);
      }

      .post-card.hidden {
        display: none !important;
      }

      .post-link {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .image-wrapper {
        border-bottom: var(--border-mega, 3px solid #000);
        overflow: hidden;
        max-height: 200px;
      }

      .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.2s ease;
      }

      .post-card:hover .image-wrapper img {
        transform: scale(1.03);
      }

      .card-content {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        font-family: var(--font-code, monospace);
        font-size: 0.75rem;
        color: var(--text-secondary, #555);
      }

      .post-title {
        font-family: var(--font-heading, system-ui);
        font-size: 1.35rem;
        line-height: 1.25;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary, #000);
      }
      .post-title-link {
        color: inherit;
        text-decoration: none;
        font-family: var(--font-heading, system-ui);
        font-size: 1.35rem;
        line-height: 1.25;
      }

      .post-title-link::after {
        content: '';
        position: absolute;
        inset: 0; /* Stretches to top:0, right:0, bottom:0, left:0 */
        z-index: 1;
      }

      .post-card:hover .post-title-link {
        text-decoration: underline;
      }
      
      .post-card:hover .post-title {
        text-decoration: underline;
      }

      .post-description {
        font-size: 0.9rem;
        color: var(--text-secondary, #444);
        line-height: 1.45;
        margin-bottom: 1.25rem;
        flex-grow: 1;
      }

      .card-footer {
        border-top: 2px dashed var(--dot-color, #ccc);
        padding-top: 0.85rem;
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-heading, system-ui);
        font-weight: 800;
        font-size: 0.9rem;
        color: var(--text-primary, #000);
      }

      .card-footer .arrow {
        transition: transform 0.15s ease;
      }

      .post-card:hover .card-footer .arrow {
        transform: translateX(4px);
      }

      .no-results {
        padding: 3rem 1rem;
        text-align: center;
      }

      .empty-card {
        background: var(--bg-card, #fff);
        border: var(--border-mega, 3px solid #000);
        box-shadow: var(--shadow-hard, 5px 5px 0px #000);
        border-radius: var(--radius-cartoon, 16px);
        padding: 2.5rem;
        max-width: 480px;
        margin: 0 auto;
      }

      .empty-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 0.5rem;
      }

      .clear-btn {
        margin-top: 1.25rem;
        font-family: var(--font-heading, system-ui);
        font-weight: 800;
        padding: 0.65rem 1.25rem;
        background: var(--accent-pink, #ff71ce);
        color: var(--color-black, #000);
        border: var(--border-thick, 2px solid #000);
        border-radius: 10px;
        box-shadow: var(--shadow-hard-sm, 3px 3px 0px #000);
        cursor: pointer;
      }
      .card {
        background: var(--bg-card);
        border: var(--border-mega);
        box-shadow: var(--shadow-hard);
        border-radius: var(--radius-cartoon);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
      }

      .card:hover {
        transform: translate(-3px, -3px);
        box-shadow: var(--shadow-hard-lg);
      }

      .card-tag {
        align-self: flex-start;
        font-family: var(--font-heading);
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        border: var(--border-thick);
        border-radius: var(--radius-pill);
        margin-bottom: 0.2rem;
      }

      .tag-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      .card-tag {
        align-self: flex-start;
        font-family: var(--font-heading, system-ui);
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.2rem 0.6rem;
        border: var(--border-thick, 2px solid #000);
        border-radius: var(--radius-pill, 999px);
        box-shadow: 2px 2px 0px #000;
        text-transform: uppercase;
      }

      .tag-gcse { 
        background: var(--accent-lime, #b1f100); 
        color: #000; 
      }
      .tag-alevel { 
        background: var(--accent-purple, #a855f7); 
        color: #fff; 
      }

      .tag-aqa { 
        background: var(--accent-blue, #60a5fa); 
        color: #000; 
      }
      .tag-ocra { 
        background: var(--accent-pink, #ff71ce); 
        color: #000; 
      }
      .tag-edexcel { 
        background: var(--accent-yellow, #facc15); 
        color: #000; 
      }
      .tag-cie { 
        background: #38bdf8; 
        color: #000; 
      }

      .tag-default { 
        background: #e2e8f0; 
        color: #000; 
      }

      .card h3 {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
        line-height: 1.25;
      }

      .card p {
        font-size: 0.95rem;
        color: #475569;
        margin-bottom: 1.2rem;
      }

      .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-code);
        font-size: 0.8rem;
        font-weight: 700;
        border-top: 2px dashed #cbd5e1;
        padding-top: 0.8rem;
      }

      .read-time {
        color: #475569;
      }

    </style>
  </head>
  <body>
    <Header />
    <main>
      <header class="page-header">
        <span class="badge">📚 Syllabus Notes & Walkthroughs</span>
        <h1>Revision Notes & Articles</h1>
        <p class="subtitle">
          Filter by GCSE/A-level and exam board to access model answers, code breakdowns, and topic notes.
        </p>
      </header>

      <section class="filter-section">
        <div class="filter-group">
          <span class="filter-label">Level:</span>
          <div class="filter-pills" id="level-filters">
            {LEVELS.map((level) => (
              <button 
                class={`filter-btn ${level.id === 'all' ? 'active' : ''}`}
                data-filter-type="level"
                data-filter-val={level.id}
              >
                {level.label}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Exam Board:</span>
          <div class="filter-pills" id="board-filters">
            {BOARDS.map((board) => (
              <button 
                class={`filter-btn ${board.id === 'all' ? 'active' : ''}`}
                data-filter-type="board"
                data-filter-val={board.id}
              >
                {board.label}
              </button>
            ))}
          </div>
        </div>
      </section>

      <div class="results-bar">
        <span id="results-count">Showing all notes</span>
        <button id="reset-btn" class="reset-btn" style="display: none;">
          ✕ Reset Filters
        </button>
      </div>

      <section>
        <ul class="posts-grid" id="posts-grid">
          {
            posts.map((post) => {
              const rawLevel = post.data.level.toLowerCase().replace(/[^a-z0-9]/g, '');
              const rawBoard = post.data.board.toLowerCase().replace(/[^a-z0-9]/g, '');

              const levelClass = rawLevel === 'gcse' ? 'tag-gcse' 
                : rawLevel === 'alevel' ? 'tag-alevel' 
                : 'tag-default';

              const boardClass = ['aqa', 'ocra', 'edexcel', 'cie'].includes(rawBoard) 
                ? `tag-${rawBoard}` 
                : 'tag-default';
              const levelLabel = post.data.level.toLowerCase() === 'all' ? 'All Levels' : post.data.level.toUpperCase();
              const boardLabel = post.data.board.toLowerCase() === 'all' ? 'All Boards' : post.data.board.toUpperCase();

              return (
                <li 
                  class="post-card card" 
                  data-board={post.data.board.toLowerCase()} 
                  data-level={post.data.level.toLowerCase()}
                >
                  <div>
                    <div class="tag-group">
                      <span class={`card-tag ${levelClass}`}>{levelLabel}</span>
                      <span class={`card-tag ${boardClass}`}>{boardLabel}</span>
                    </div>
                    <h3>
                      <a href={`/blog/${post.id}/`} class="post-title-link">
                        {post.data.title}
                      </a>
                    </h3>
                    <p>{post.data.description}</p>
                  </div>
                  <div class="card-footer">
                    <span><FormattedDate date={post.data.pubDate} /></span>
                    <span class="read-time">⏱️ {post.data.learningTime} read</span>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- Empty State -->
      <div class="no-results" id="no-results" style="display: none;">
        <div class="empty-card">
          <span class="empty-icon">🔍</span>
          <h3>No notes found matching those filters</h3>
          <p>Try switching exam boards or clearing your level selection.</p>
          <button id="clear-filters-btn" class="clear-btn">Clear All Filters</button>
        </div>
      </div>
    </main>
    <Footer />

    <!-- Dynamic Filter Logic -->
    <script>
      function initFilters() {
        let activeLevel = 'all';
        let activeBoard = 'all';

        const posts = document.querySelectorAll<HTMLElement>('.post-card');
        const levelBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-type="level"]');
        const boardBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-type="board"]');
        const resultsCount = document.getElementById('results-count');
        const resetBtn = document.getElementById('reset-btn');
        const clearFiltersBtn = document.getElementById('clear-filters-btn');
        const noResults = document.getElementById('no-results');

        // Parse query params (e.g. ?board=aqa)
        const urlParams = new URLSearchParams(window.location.search);
        const paramBoard = urlParams.get('board');
        const paramLevel = urlParams.get('level');

        if (paramBoard) activeBoard = paramBoard.toLowerCase();
        if (paramLevel) activeLevel = paramLevel.toLowerCase();

        function updateButtonUI() {
          levelBtns.forEach(btn => {
            btn.classList.toggle('active', btn.dataset.filterVal === activeLevel);
          });
          boardBtns.forEach(btn => {
            btn.classList.toggle('active', btn.dataset.filterVal === activeBoard);
          });
        }

        function applyFilters() {
          let visibleCount = 0;

          posts.forEach(post => {
            const postBoard = post.dataset.board || 'all';
            const postLevel = post.dataset.level || 'all';

            const matchLevel = activeLevel === 'all' || postLevel === 'all' || postLevel === activeLevel;
            const matchBoard = activeBoard === 'all' || postBoard === 'all' || postBoard === activeBoard;

            if (matchLevel && matchBoard) {
              post.classList.remove('hidden');
              visibleCount++;
            } else {
              post.classList.add('hidden');
            }
          });

          if (resultsCount) {
            if (activeLevel === 'all' && activeBoard === 'all') {
              resultsCount.textContent = `Showing all ${visibleCount} notes`;
            } else {
              resultsCount.textContent = `Found ${visibleCount} matching note${visibleCount === 1 ? '' : 's'}`;
            }
          }

          if (resetBtn) {
            resetBtn.style.display = (activeLevel !== 'all' || activeBoard !== 'all') ? 'inline-block' : 'none';
          }

          if (noResults) {
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
          }

          updateButtonUI();
        }

        levelBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            activeLevel = btn.dataset.filterVal || 'all';
            applyFilters();
          });
        });

        boardBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            activeBoard = btn.dataset.filterVal || 'all';
            applyFilters();
          });
        });

        const resetAll = () => {
          activeLevel = 'all';
          activeBoard = 'all';
          applyFilters();
        };

        resetBtn?.addEventListener('click', resetAll);
        clearFiltersBtn?.addEventListener('click', resetAll);

        applyFilters();
      }

      initFilters();
      document.addEventListener('astro:after-swap', initFilters);
    </script>
  </body>
</html>