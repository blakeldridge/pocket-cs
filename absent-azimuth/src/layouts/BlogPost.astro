---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, board, level, learningTime } = Astro.props;
---

<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    
    <BaseHead title={title} description={description} />

    <style>
      main {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem 5rem 1rem;
      }

      /* Main Neubrutalist Outer Container */
      .article-container {
        background: var(--bg-card, #ffffff);
        border: var(--border-mega, 3px solid #000000);
        box-shadow: var(--shadow-hard, 6px 6px 0px #000000);
        border-radius: var(--radius-cartoon, 16px);
        overflow: hidden;
      }

      /* Header Section Inside Card */
      .article-header {
        padding: 2.5rem 2.5rem 1.5rem 2.5rem;
        border-bottom: 2px dashed var(--dot-color, #cccccc);
        background: var(--bg-card, #ffffff);
      }

      .meta-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        font-family: var(--font-code, 'JetBrains Mono', monospace);
        font-size: 0.85rem;
      }
      .tag-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      .card-tag {
        align-self: flex-start;
        font-family: var(--font-heading, system-ui);
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.2rem 0.6rem;
        border: var(--border-thick, 2px solid #000);
        border-radius: var(--radius-pill, 999px);
        box-shadow: 2px 2px 0px #000;
        text-transform: uppercase;
      }

      .tag-gcse { 
        background: var(--accent-lime, #b1f100); 
        color: #000; 
      }
      .tag-a-level { 
        background: var(--accent-purple, #a855f7); 
        color: #fff; 
      }

      .tag-aqa { 
        background: var(--accent-blue, #60a5fa); 
        color: #000; 
      }
      .tag-ocr-a { 
        background: var(--accent-pink, #ff71ce); 
        color: #000; 
      }
      .tag-edexcel { 
        background: var(--accent-yellow, #facc15); 
        color: #000; 
      }
      .tag-cie { 
        background: #38bdf8; 
        color: #000; 
      }

      .tag-default { 
        background: #e2e8f0; 
        color: #000; 
      }

      .badge {
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border: var(--border-thick, 2px solid #000000);
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .badge-level {
        background: var(--accent-yellow, #facc15);
        color: var(--color-black, #000000);
      }

      .badge-board {
        background: var(--accent-blue, #60a5fa);
        color: var(--color-black, #000000);
      }

      .badge-time {
        background: var(--accent-lime, #b1f100);
        color: var(--color-black, #000000);
      }

      .dates-wrapper {
        color: var(--text-secondary, #555555);
        display: flex;
        flex-direction: column;
        align-items: flex-end;
      }

      .last-updated-on {
        font-size: 0.75rem;
        font-style: italic;
      }

      h1.post-title {
        font-family: var(--font-heading, 'Fredoka', system-ui);
        font-size: clamp(2rem, 5vw, 2.8rem);
        font-weight: 700;
        color: var(--text-primary, #000000);
        line-height: 1.15;
        margin: 0 0 1rem 0;
      }

      .post-description {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.1rem;
        color: var(--text-secondary, #444444);
        line-height: 1.5;
        margin: 0;
      }

      /* Article Body / Markdown Prose */
      .prose {
        padding: 2.5rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-primary, #111111);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      @media (max-width: 640px) {
        .article-header, .prose {
          padding: 1.5rem;
        }
        .dates-wrapper {
          align-items: flex-start;
        }
      }

      /* --- Prose Typography & Heading Pops --- */
      .prose :global(h2) {
        font-family: var(--font-heading, 'Fredoka', system-ui);
        font-size: 1.8rem;
        font-weight: 700;
        margin: 2.2rem 0 1rem 0;
        color: var(--text-primary, #000000);
        border-bottom: 2px solid var(--color-black, #000000);
        padding-bottom: 0.3rem;
      }

      .prose :global(h3) {
        font-family: var(--font-heading, 'Fredoka', system-ui);
        font-size: 1.4rem;
        font-weight: 600;
        margin: 1.8rem 0 0.75rem 0;
        color: var(--text-primary, #000000);
      }

      .prose :global(p) {
        margin-bottom: 1.25rem;
      }

      .prose :global(ul), .prose :global(ol) {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
      }

      .prose :global(li) {
        margin-bottom: 0.4rem;
      }

      .prose :global(blockquote) {
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        background: var(--bg-body, #f8f8f6);
        border-left: 5px solid var(--accent-pink, #ff71ce);
        border-top: var(--border-thick, 2px solid #000000);
        border-right: var(--border-thick, 2px solid #000000);
        border-bottom: var(--border-thick, 2px solid #000000);
        border-radius: 8px;
        box-shadow: 3px 3px 0px #000000;
        font-weight: 500;
      }

      .prose :global(hr) {
        border: none;
        border-top: 2px dashed var(--dot-color, #cccccc);
        margin: 2.5rem 0;
      }

      /* --- Clean Code Box Styling --- */
      .prose :global(pre) {
        background: #1e1e2e !important;
        color: #cdd6f4 !important;
        border: var(--border-thick, 2px solid #000000);
        border-radius: 12px;
        box-shadow: 4px 4px 0px #000000;
        padding: 1.25rem;
        overflow-x: auto;
        font-family: var(--font-code, 'JetBrains Mono', monospace);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 1.5rem 0;
      }

      .prose :global(code) {
        font-family: var(--font-code, 'JetBrains Mono', monospace);
      }

      /* Inline Code Snippets */
      .prose :global(:not(pre) > code) {
        background: var(--bg-body, #f3f3ee);
        color: var(--text-primary, #000000);
        border: 1px solid #000000;
        padding: 0.15rem 0.4rem;
        border-radius: 6px;
        font-size: 0.88em;
        font-weight: 700;
      }

      /* Tables inside Content */
      .prose :global(table) {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 1.5rem 0;
        border: var(--border-thick, 2px solid #000000);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 3px 3px 0px #000000;
      }

      .prose :global(th) {
        background: var(--accent-yellow, #facc15);
        color: #000000;
        font-family: var(--font-heading, 'Fredoka', system-ui);
        font-weight: 700;
        padding: 0.75rem;
        border-bottom: 2px solid #000000;
        text-align: left;
      }

      .prose :global(td) {
        padding: 0.75rem;
        border-bottom: 1px solid var(--dot-color, #e5e5e5);
      }

      .prose :global(tr:last-child td) {
        border-bottom: none;
      }

    </style>

    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
  </head>

  <body>
    <Header />
    <main>
      <article class="article-container">

        <header class="article-header">
          <div class="meta-bar">
            <div class="tag-group">
              {level && <span class={`card-tag tag-${level}`}>{level}</span>}
              {board && <span class={`card-tag tag-${board}`}>{board}</span>}
              {learningTime && <span class={`card-tag tag-default`}>{learningTime}</span>}
            </div>

            <div class="dates-wrapper">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span class="last-updated-on">
                  Updated: <FormattedDate date={updatedDate} />
                </span>
              )}
            </div>
          </div>

          <h1 class="post-title">{title}</h1>

          {description && <p class="post-description">{description}</p>}
        </header>

        <div class="prose">
          <slot />
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>